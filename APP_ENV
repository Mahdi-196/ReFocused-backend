# Application Settings
APP_NAME=ReFocused
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# Core Security & Auth
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASHER=bcrypt
BCRYPT_ROUNDS=12

# Database Settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/refocused-local-testing
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# CORS Settings
CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_METHODS='["*"]'
CORS_ALLOWED_HEADERS='["*"]'

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60
RATE_LIMIT_BLOCK_DURATION=300

# Security Headers
SECURITY_HSTS_ENABLED=True
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=True
SECURITY_HSTS_PRELOAD=False
SECURITY_FRAME_DENY=True
SECURITY_XSS_PROTECTION=True
SECURITY_CONTENT_TYPE_NOSNIFF=True
SECURITY_REFERRER_POLICY="strict-origin-when-cross-origin"
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"

# CSP
CSP_ENABLED=True
# (CSP_DIRECTIVES left to defaults in SecurityConfig)

# Security Logging
SECURITY_LOG_ENABLED=True
SECURITY_LOG_PATH="security_events.log"
SECURITY_LOG_LEVEL="INFO"

# Max Upload Size
MAX_UPLOAD_SIZE=10485760

# Trusted Hosts (optional)
TRUSTED_HOSTS='[]'

# Rate Limit Header Names (used by your middleware)
API_RATE_LIMIT_REMAINING="X-RateLimit-Remaining"
API_RATE_LIMIT_RESET="X-RateLimit-Reset"
API_RATE_LIMIT_HEADER="X-RateLimit-Limit"
API_VERSION_HEADER="X-API-Version"
